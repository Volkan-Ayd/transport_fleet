<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="transport_vehicle_profitability_report_view_pivot" model="ir.ui.view">
        <field name="name">transport.vehicle.profitability.report.pivot</field>
        <field name="model">transport.vehicle.profitability.report</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="vehicle_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="revenue" type="measure"/>
                <field name="driver_cost" type="measure"/>
                <field name="fuel_cost" type="measure"/>
                <field name="hgs_cost" type="measure"/>
                <field name="net_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="transport_vehicle_profitability_report_view_graph" model="ir.ui.view">
        <field name="name">transport.vehicle.profitability.report.graph</field>
        <field name="model">transport.vehicle.profitability.report</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Araç/Şoför Kârlılık Analizi">
                <field name="vehicle_id" type="row"/>
                <field name="net_profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="transport_vehicle_profitability_report_view_list" model="ir.ui.view">
        <field name="name">transport.vehicle.profitability.report.list</field>
        <field name="model">transport.vehicle.profitability.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="trip_name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="revenue" sum="Toplam Ciro"/>
                <field name="driver_cost" sum="Toplam Şoför Hakedişi"/>
                <field name="fuel_cost" sum="Toplam Yakıt"/>
                <field name="hgs_cost" sum="Toplam HGS"/>
                <field name="net_profit" sum="Toplam Net Kâr"
                       decoration-danger="net_profit &lt; 0" decoration-success="net_profit &gt;= 0"/>
                <field name="return_distance_km" optional="show" sum="Toplam Boş Gidiş/Dönüş Km"/>
            </list>
        </field>
    </record>

    <record id="transport_vehicle_profitability_report_view_search" model="ir.ui.view">
        <field name="name">transport.vehicle.profitability.report.search</field>
        <field name="model">transport.vehicle.profitability.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="partner_id"/>
                <field name="trip_name"/>
                <filter name="done" string="Tamamlanan Seferler" domain="[('state', '=', 'done')]"/>
                <filter name="loss" string="Zararlı Seferler" domain="[('net_profit', '&lt;', 0)]"/>
                <separator/>
                <group>
                    <filter name="group_vehicle" string="Araç" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_driver" string="Şoför" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_partner" string="Müşteri" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Ay" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="transport_vehicle_profitability_report_action" model="ir.actions.act_window">
        <field name="name">Araç/Şoför Kârlılık Analizi</field>
        <field name="res_model">transport.vehicle.profitability.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_vehicle': 1}</field>
    </record>
</odoo>
