<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="transport_vehicle_assign_wizard_view_form" model="ir.ui.view">
        <field name="name">transport.vehicle.assign.wizard.form</field>
        <field name="model">transport.vehicle.assign.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="vehicle_id" readonly="1"/>
                <field name="lead_id" placeholder="Bekleyen bir teklif seçin..."/>
                <footer>
                    <button name="action_confirm" string="Ata ve Sefer Başlat" type="object"
                            class="oe_highlight"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
