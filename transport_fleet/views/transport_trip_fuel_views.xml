<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="transport_trip_fuel_view_form" model="ir.ui.view">
        <field name="name">transport.trip.fuel.form</field>
        <field name="model">transport.trip.fuel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_trip" type="object" class="oe_stat_button"
                                icon="fa-truck">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sefer</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Sefer / Şoför">
                            <field name="date"/>
                            <field name="driver_id"/>
                            <field name="trip_id" invisible="not trip_id"/>
                            <field name="grupaj_trip_id" invisible="not grupaj_trip_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group string="Yakıt">
                            <field name="currency_id" invisible="1"/>
                            <field name="odometer"/>
                            <field name="liters"/>
                            <field name="price_per_liter"/>
                            <field name="total_cost"/>
                            <field name="fuel_limit" invisible="not fuel_limit"/>
                            <field name="distance_since_last"/>
                            <field name="consumption_rate"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="transport_trip_fuel_view_list" model="ir.ui.view">
        <field name="name">transport.trip.fuel.list</field>
        <field name="model">transport.trip.fuel</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="driver_id"/>
                <field name="trip_id" optional="show"/>
                <field name="grupaj_trip_id" optional="show"/>
                <field name="vehicle_id"/>
                <field name="odometer"/>
                <field name="liters" sum="Toplam Litre"/>
                <field name="price_per_liter" optional="show"/>
                <field name="total_cost" sum="Toplam Tutar"/>
                <field name="distance_since_last" optional="show"/>
                <field name="consumption_rate" optional="show"/>
                <field name="fuel_limit" optional="show"/>
            </list>
        </field>
    </record>

    <record id="transport_trip_fuel_view_search" model="ir.ui.view">
        <field name="name">transport.trip.fuel.search</field>
        <field name="model">transport.trip.fuel</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <field name="trip_id"/>
                <field name="grupaj_trip_id"/>
                <field name="vehicle_id"/>
                <group>
                    <filter name="group_driver" string="Şoför" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_vehicle" string="Çekici" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_trip" string="Sefer" context="{'group_by': 'trip_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="transport_trip_fuel_action" model="ir.actions.act_window">
        <field name="name">Yakıt İşlemleri</field>
        <field name="res_model">transport.trip.fuel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
