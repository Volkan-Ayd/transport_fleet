<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_inherit_transport" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.transport</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <div class="mb-2" invisible="state == 'cancel'">
                    <button name="action_add_europe_crossing_line" type="object"
                            string="Avrupa Geçiş Ekle" class="btn-link p-0 me-3"/>
                    <button name="action_add_loading_unloading_line" type="object"
                            string="İndirme-Bindirme Ekle" class="btn-link p-0"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="account_move_view_form_inherit_transport" model="ir.ui.view">
        <field name="name">account.move.form.inherit.transport</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <div class="mb-2"
                     invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')">
                    <button name="action_add_europe_crossing_line" type="object"
                            string="Avrupa Geçiş Ekle" class="btn-link p-0 me-3"/>
                    <button name="action_add_loading_unloading_line" type="object"
                            string="İndirme-Bindirme Ekle" class="btn-link p-0"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="transport_crossing_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">transport.crossing.confirm.wizard.form</field>
        <field name="model">transport.crossing.confirm.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <field name="move_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Bu sefer Avrupa-Asya geçişli görünüyor (rota bilgisinde her iki kıta/yaka da
                    tespit edildi) ve henüz bir Avrupa Geçiş satırı eklenmemiş. Avrupa Geçiş
                    ücreti eklemeden devam etmek istediğinize emin misiniz?
                </div>
                <footer>
                    <button name="action_add_europe_crossing" string="Avrupa Geçişi Ekle" type="object"
                            class="oe_highlight"/>
                    <button name="action_continue" string="Devam Et" type="object"/>
                    <button string="İptal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
