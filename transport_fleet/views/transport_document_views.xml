<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="transport_document_view_list" model="ir.ui.view">
        <field name="name">transport.document.list</field>
        <field name="model">transport.document</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'expired'" decoration-warning="status == 'expiring'">
                <field name="owner_type"/>
                <field name="owner_name"/>
                <field name="doc_type"/>
                <field name="reference" optional="show"/>
                <field name="issue_date" optional="hide"/>
                <field name="expiry_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'valid'"
                       decoration-warning="status == 'expiring'"
                       decoration-danger="status == 'expired'"/>
                <field name="responsible_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="transport_document_view_form" model="ir.ui.view">
        <field name="name">transport.document.form</field>
        <field name="model">transport.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Süresi Dolmuş" bg_color="text-bg-danger"
                            invisible="status != 'expired'"/>
                    <widget name="web_ribbon" title="Süresi Yaklaşıyor" bg_color="text-bg-warning"
                            invisible="status != 'expiring'"/>
                    <group>
                        <group string="Sahibi">
                            <field name="owner_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="vehicle_id" invisible="owner_type != 'vehicle'"
                                   required="owner_type == 'vehicle'"/>
                            <field name="trailer_id" invisible="owner_type != 'trailer'"
                                   required="owner_type == 'trailer'"/>
                            <field name="employee_id" invisible="owner_type != 'employee'"
                                   required="owner_type == 'employee'"/>
                        </group>
                        <group string="Belge">
                            <field name="doc_type"/>
                            <field name="reference"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="alert_days"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'valid'"
                                   decoration-warning="status == 'expiring'"
                                   decoration-danger="status == 'expired'"/>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                        <field name="note"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="transport_document_view_search" model="ir.ui.view">
        <field name="name">transport.document.search</field>
        <field name="model">transport.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="vehicle_id"/>
                <field name="trailer_id"/>
                <field name="employee_id"/>
                <filter name="expired" string="Süresi Dolmuş"
                        domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expiring" string="30 Gün İçinde Bitecek"
                        domain="[('expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('expiry_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_vehicle" string="Araç" domain="[('owner_type', '=', 'vehicle')]"/>
                <filter name="f_trailer" string="Dorse" domain="[('owner_type', '=', 'trailer')]"/>
                <filter name="f_employee" string="Şoför" domain="[('owner_type', '=', 'employee')]"/>
                <group>
                    <filter name="group_type" string="Belge Türü" context="{'group_by': 'doc_type'}"/>
                    <filter name="group_owner" string="Sahip Tipi" context="{'group_by': 'owner_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="transport_document_action" model="ir.actions.act_window">
        <field name="name">Belgeler</field>
        <field name="res_model">transport.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_expiring': 1}</field>
    </record>
</odoo>
